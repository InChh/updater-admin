# Database and Better Auth (server only unless explicitly marked public).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Comma-separated exact browser origins for anonymous /api/public/v1 reads.
# Native/server consumers omit Origin and do not require an entry. Production
# entries must use HTTPS; localhost HTTP is accepted only outside production.
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:3000

# DESTRUCTIVE TESTS ONLY: use a fresh disposable Neon branch, never DATABASE_URL.
# Set TEST_DATABASE_CONFIRM_DISPOSABLE to updater-admin-destructive-tests only
# after independently verifying that TEST_DATABASE_URL is disposable.
TEST_DATABASE_URL=
TEST_DATABASE_CONFIRM_DISPOSABLE=

# One-time bootstrap values. Passwords must be 12-128 characters with at
# least 8 unique characters and cannot be a repeated pattern. Remove the
# password from every environment immediately after bootstrap succeeds.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# VITE_SENTRY_DSN is the only environment variable read from import.meta.env in
# browser code. Leave it empty to disable browser reporting.
VITE_SENTRY_DSN=

# Server-side Sentry capture and source-map upload. SENTRY_DSN is optional; if
# set, SENTRY_ENVIRONMENT is required. Source-map upload is enabled only when
# SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT are all present. Netlify
# supplies COMMIT_REF as the release; local builds may use SENTRY_RELEASE.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Optional application release label shown to authenticated administrators on
# the monitoring page. Netlify supplies DEPLOY_ID, COMMIT_REF and CONTEXT
# automatically for the other build metadata fields.
APP_VERSION=

# Server-only Aliyun OSS/STS configuration. OSS_REGION uses the ali-oss form
# (for example oss-cn-shanghai); OSS_STS_ENDPOINT is the public STS host (for
# example sts.cn-shanghai.aliyuncs.com). Keep the upload prefix dedicated to
# this environment and never expose the permanent RAM keys to browser code.
# The permanent principal needs sts:AssumeRole on the upload role and a
# separate prefix-scoped oss:GetObject grant for server-side metadata HEADs.
# The assumed browser role must not receive GetObject.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_RAM_ROLE_ARN=
OSS_STS_ENDPOINT=sts.cn-shanghai.aliyuncs.com
OSS_BUCKET=
OSS_REGION=oss-cn-shanghai
OSS_UPLOAD_PREFIX=updater-admin/

# Authenticated Playwright suites only. Seed a disposable test administrator;
# leave both values empty to run only the anonymous browser coverage.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
